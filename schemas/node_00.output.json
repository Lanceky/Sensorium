{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node_00.output.json",
  "title": "Node 0 - Passive Signal Log (deterministic, no LLM)",
  "description": "Timestamped passive signal events. Produced on-device; only aggregates leave the device (context.md 3.5).",
  "type": "object",
  "properties": {
    "profile_id": { "type": "string", "minLength": 1 },
    "window": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": { "type": "string", "format": "date-time" },
          "signal": { "$ref": "common.json#/$defs/signal_kind" },
          "value": { "type": "number" }
        },
        "required": ["ts", "signal", "value"],
        "additionalProperties": false
      }
    }
  },
  "required": ["profile_id", "window", "events"],
  "additionalProperties": false
}
