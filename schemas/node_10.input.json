{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node_10.input.json",
  "title": "Node 10 - Doctor-Shareable Report Generator input",
  "type": "object",
  "properties": {
    "trend_data": { "$ref": "node_03.output.json" },
