{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node_0_5.input.json",
  "title": "Node 0.5 - Relative Self-Check input",
  "description": "Verbatim from context.md 4: {\"sessions\": [{\"date\": str, \"step_reached\": int, \"modality\": \"vision\"|\"hearing\"}]}",
  "type": "object",
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
