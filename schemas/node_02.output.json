{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node_02.output.json",
  "title": "Node 2 - Journal Signal Extractor output",
  "description": "source_quote must be a literal substring of the conversation. Enforced in code at Step 5, not by this schema.",
  "type": "object",
  "properties": {
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "source_quote": { "type": "string", "minLength": 1 },
          "modality": { "$ref": "common.json#/$defs/modality_or_unclear" }
        },
        "required": ["claim", "source_quote", "modality"],
        "additionalProperties": false
      }
    }
  },
  "required": ["observations"],
  "additionalProperties": false
}
