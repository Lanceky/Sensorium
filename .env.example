# Copy to .env and fill in. Never commit the filled version.

# Featherless.AI - OpenAI-compatible, base URL https://api.featherless.ai/v1
# Model ids are pinned in Step 3 from a live GET /v1/models response.
FEATHERLESS_API_KEY=

# Wolfram|One - Node 3 statistics engine (Step 4)
WOLFRAM_APP_ID=

# Firecrawl - Node 6/10 live retrieval (Step 8)
FIRECRAWL_API_KEY=
